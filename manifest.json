{
  "manifest_version": 3,
  "name": "ioBios Extension",
  "version": "0.1.0",
  "description": "Extensión ioBios para AppSheet",
  "permissions": ["storage", "activeTab", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.appsheet.com/start/6f5178ea-4877-4f23-9749-721b993b406a*"],
      "js": ["content/appsheet-session.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.appsheet.com/start/6f5178ea-4877-4f23-9749-721b993b406a*"],
      "js": [
        "content/shared/session.js",
        "content/shared/config.js",
        "content/shared/date-utils.js",
        "content/shared/appsheet-utils.js",
        "content/shared/ui.js",
        "content/db/timeallocations-db.js",
        "content/db/timesheets-db.js",
        "content/db/absences-db.js",
        "content/timeallocations/state.js",
        "content/timeallocations/renderer.js",
        "content/timeallocations/panel.js",
        "content/timeallocations/save.js",
        "content/timesheets/state.js",
        "content/timesheets/renderer.js",
        "content/timesheets/panel.js",
        "content/timesheets/save.js",
        "content/badge.js",
        "content/content.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
